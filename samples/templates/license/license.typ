// Sample license certificate (use case B).
// Data comes in as JSON, never as interpolated markup. The data file name can
// be overridden with `--input data=<path>`; paths resolve against --root.
#let data = json(sys.inputs.at("data", default: "/data.json"))

#let brand = rgb("#14365d")
#let muted = rgb("#4a6a8a")

#set document(title: [License #data.licenseId], author: "Fjordlight Systems")
#set page(
  paper: "a4",
  margin: (x: 2.2cm, top: 2.5cm, bottom: 2.5cm),
  header: context {
    if counter(page).get().first() > 1 [
      #set text(8pt, fill: muted)
      #data.product license #data.licenseId #h(1fr) #data.licensee.organization
    ]
  },
  footer: context [
    #set text(8pt, fill: muted)
    Fjordlight Systems · Fictional sample generated by Typstium
    #h(1fr)
    Page #counter(page).display() of #counter(page).final().first()
  ],
)
#set text(font: ("Source Sans 3", "Libertinus Serif"), size: 10.5pt, lang: "en")
#set par(justify: true)

#grid(
  columns: (1fr, auto),
  align: (left + horizon, right + horizon),
  image("/logo.svg", height: 1.4cm),
  text(fill: muted)[License ID\ #text(14pt, weight: "bold", fill: brand, data.licenseId)],
)

#v(1.2cm)
#text(26pt, weight: "bold", fill: brand)[Software License Certificate]
#v(0.2cm)
#text(13pt, fill: muted)[#data.product · #data.edition edition]
#v(0.8cm)

#grid(
  columns: (1fr, 1fr),
  gutter: 1cm,
  [
    #text(weight: "semibold", fill: brand)[Licensee]\
    #data.licensee.organization\
    #for line in data.licensee.address [#line\ ]
    #data.licensee.contact · #link("mailto:" + data.licensee.email)[#data.licensee.email]
  ],
  [
    #text(weight: "semibold", fill: brand)[License period]\
    Issued: #data.issued\
    Expires: #data.expires\
    Seats: #data.seats
  ],
)

#v(0.8cm)
#text(weight: "semibold", fill: brand)[Licensed features]
#v(0.2cm)
#table(
  columns: (1fr, auto, auto),
  stroke: (x, y) => if y == 0 { (bottom: 1pt + brand) } else { (bottom: 0.4pt + luma(220)) },
  fill: (x, y) => if y > 0 and calc.even(y) { luma(247) },
  inset: (x: 6pt, y: 5pt),
  table.header([*Feature*], [*Included*], [*Limit*]),
  ..data.features.map(f => (
    f.name,
    if f.included { text(fill: rgb("#1b7f3b"))[Yes] } else { text(fill: rgb("#a33"))[No] },
    if f.limit == none { [—] } else { f.limit },
  )).flatten(),
)

#v(0.8cm)
#text(weight: "semibold", fill: brand)[Terms]
#v(0.2cm)
#data.terms

// A second page of boilerplate so the sample exercises page breaks,
// running headers and the page counter.
#pagebreak()
#text(weight: "semibold", fill: brand)[General conditions]
#for i in range(1, 9) [
  #v(0.2cm)
  *#i. Condition #i.* #lorem(80)
]

#v(1cm)
#grid(
  columns: (1fr, 1fr),
  gutter: 1cm,
  [#line(length: 100%, stroke: 0.5pt + muted) #text(9pt, fill: muted)[For Fjordlight Systems]],
  [#line(length: 100%, stroke: 0.5pt + muted) #text(9pt, fill: muted)[For #data.licensee.organization]],
)
