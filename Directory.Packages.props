<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Polyfill" Version="11.4.3" />
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.12" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="TUnit" Version="1.76.0" />
    <PackageVersion Include="TUnit.Core" Version="1.76.0" />
    <PackageVersion Include="TUnit.Assertions" Version="1.76.0" />
    <!-- Cake.Typstium (docs/specs/cake.md): the addin builds against the first Cake 6 so every Cake 6.x loads it;
         the tests use the fakes of the Cake version the repository's build runs. -->
    <PackageVersion Include="Cake.Core" Version="6.0.0" />
    <PackageVersion Include="Cake.Testing" Version="6.3.0" />
    <!-- Test-only: Cake.Typstium's unit tests check that tool folder versions order exactly as NuGet orders them. -->
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <!-- The build under build/ (docs/specs/cake-sdk-build.md). Cake.Common matches Cake.Sdk in global.json;
         Spectre.Console matches the version Cake.Cli ships (build/Build fails if Cake needs a newer one). -->
    <PackageVersion Include="Cake.Common" Version="6.3.0" />
    <PackageVersion Include="Cake.BuildSystems.Module" Version="9.0.0" />
    <PackageVersion Include="ReportGenerator.Core" Version="5.5.11" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="SharpCompress" Version="1.0.0" />
    <!-- Not used directly: build/Build pins it above the version Cake.Sdk brings through Cake.NuGet and NuGet.Packaging
         (10.0.12), which has CVE-2026-70162 and CVE-2026-84008 (fixed in 10.0.13). Drop the pin once Cake.Sdk brings a
         patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
